{
  "name": "@anvara/hush",
  "version": "0.3.0",
  "description": "Local-first secret management from the terminal.",
  "type": "module",
  "bin": {
    "hush": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chitresh-code/hush.git"
  },
  "homepage": "https://github.com/Chitresh-code/hush#readme",
  "bugs": {
    "url": "https://github.com/Chitresh-code/hush/issues"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@termuijs/core": "0.1.7",
    "@termuijs/jsx": "0.1.7",
    "@termuijs/router": "0.1.7",
    "@termuijs/store": "0.1.7",
    "@termuijs/tss": "0.1.7",
    "@termuijs/widgets": "0.1.7",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@termuijs/testing": "0.1.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
